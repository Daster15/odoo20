<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_m365_safety_scan" model="ir.cron">
        <field name="name">M365 Bridge: safety scan of time off changes</field>
        <field name="model_id" ref="model_m365_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_safety_scan()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_m365_purge" model="ir.cron">
        <field name="name">M365 Bridge: purge picked-up outbox</field>
        <field name="model_id" ref="model_m365_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
